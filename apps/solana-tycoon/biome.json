{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"root": false,
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"test/**/*.ts",
			"scripts/**/*.ts",
			"e2e/**/*.ts",
			"*.ts",
			"*.json",
			"!package-lock.json"
		]
	}
}
