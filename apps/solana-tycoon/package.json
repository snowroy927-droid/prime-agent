{
	"name": "super-c-sniper",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Personal pump.fun command center: paper-trading engine and gamified trading-floor dashboard.",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build:web": "vite build",
		"start": "npm run build:web && tsx src/engine/main.ts",
		"demo": "npm run build:web && tsx src/engine/main.ts --demo",
		"replay": "npm run build:web && tsx src/engine/main.ts --replay",
		"make-demo": "tsx scripts/make-demo.ts",
		"check": "biome check --write --error-on-warnings . && tsc --noEmit",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@playwright/test": "1.64.0",
		"@types/bn.js": "5.2.0",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.186.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.1.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.2.4",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@fontsource/press-start-2p": "5.3.0",
		"@fontsource/vt323": "5.3.0",
		"@pump-fun/pump-sdk": "3.2.0",
		"@pump-fun/pump-swap-sdk": "1.20.0",
		"@solana/spl-token": "0.4.15",
		"@solana/web3.js": "1.99.0",
		"bn.js": "5.2.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"three": "0.186.1",
		"ws": "8.22.0",
		"zod": "4.6.5"
	}
}
