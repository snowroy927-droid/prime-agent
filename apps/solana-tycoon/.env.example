# Solana HTTP RPC. Leave unset to use the public mainnet endpoint (rate-limited, not for heavy use).
RPC_URL=https://api.mainnet-beta.solana.com
# Solana websocket RPC. Derived from RPC_URL when unset (https -> wss).
RPC_WS_URL=
# paper or live. Live trading arrives in Milestone 2.
MODE=paper
# Live only: path to a solana-keygen JSON keypair file for a dedicated burner wallet. Never commit it.
KEYPAIR_PATH=
# Port for the dashboard and engine bridge on 127.0.0.1.
PORT=7777
# Maximum RPC requests per second the engine may spend.
RPC_MAX_RPS=5
# Kraken desk: paper trading on live Kraken public prices (no API keys). Set to off to run pump.fun only.
KRAKEN=on
